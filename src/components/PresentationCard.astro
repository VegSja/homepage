---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  presentation: CollectionEntry<'presentations'>;
}

const { presentation } = Astro.props;
const formattedDate = presentation.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---
<div class="border-b border-gray-200 dark:border-gray-800 py-6 last:border-0 group">
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
    <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
      {presentation.data.slidesUrl ? (
        <a href={presentation.data.slidesUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1">
          {presentation.data.title}
          <Icon name="arrow-up-right" class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" />
        </a>
      ) : (
        presentation.data.title
      )}
    </h3>
    <div class="text-sm font-mono text-gray-500 dark:text-gray-400 mt-1 sm:mt-0">
      {formattedDate} {presentation.data.event && `· ${presentation.data.event}`}
    </div>
  </div>
  <p class="text-gray-600 dark:text-gray-400 mb-3 text-sm">
    {presentation.data.description}
  </p>
  <div class="flex items-center gap-4">
    <a href={presentation.data.repoUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white flex items-center gap-1 transition-colors">
      <Icon name="github" class="w-4 h-4" /> Code
    </a>
    <div class="flex gap-2">
      {presentation.data.tags.map(tag => (
        <span class="text-xs font-mono text-gray-400 dark:text-gray-500">#{tag}</span>
      ))}
    </div>
  </div>
</div>
