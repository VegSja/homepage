---
import { timeline } from '../data/experience';
---
<section class="py-12 border-t border-gray-200 dark:border-gray-800 animate-fade-in-up" style="animation-delay: 150ms;">
  <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">Experience</h2>
  <ol class="relative border-l border-gray-200 dark:border-gray-800 ml-2 space-y-8">
    {timeline.map((entry) => (
      <li class="relative pl-6">
        <span
          class={`absolute -left-[7px] top-1.5 w-3 h-3 rounded-full ring-4 ring-gray-50 dark:ring-gray-950 ${
            entry.kind === 'education'
              ? 'bg-gray-400 dark:bg-gray-500'
              : entry.kind === 'verv'
                ? 'bg-emerald-500'
                : 'bg-accent-500'
          }`}
          aria-hidden="true"
        ></span>
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3">
          <time class="text-xs font-mono text-gray-500 dark:text-gray-400 whitespace-nowrap">
            {entry.period}
          </time>
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">
            {entry.role}
            <span class="text-gray-500 dark:text-gray-400 font-normal"> · {entry.organization}</span>
          </h3>
        </div>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400 max-w-2xl">
          {entry.subheader}
        </p>
      </li>
    ))}
  </ol>
</section>
