---
import { withBase } from '../lib/urls';
---
<section class="py-12 md:py-20 animate-fade-in">
  <div class="max-w-3xl">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-6">
      Hi, I'm Vegard <span class="text-accent-500">.</span>
    </h1>
    <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 mb-8 leading-relaxed">
      Data Engineer at <span class="font-semibold text-gray-900 dark:text-white">Bekk</span> helping the financial sector turn messy data into clear decisions.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href={withBase('/projects')} class="inline-flex items-center px-5 py-3 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors">
        View Projects
      </a>
      <a href="mailto:vgsjaavik@gmail.com" class="inline-flex items-center px-5 py-3 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 font-medium hover:border-gray-300 dark:hover:border-gray-700 transition-colors">
        Contact Me
      </a>
    </div>
  </div>
</section>
