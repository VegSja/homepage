---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/urls';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---
<article class="group relative flex flex-col items-start justify-between">
  <div class="flex items-center gap-x-4 text-xs font-mono text-gray-500 dark:text-gray-400 mb-3">
    <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
    {post.data.tags.length > 0 && (
      <span class="relative z-10 rounded-full bg-gray-100 dark:bg-gray-800 px-3 py-1.5 font-medium text-gray-600 dark:text-gray-300">
        {post.data.tags[0]}
      </span>
    )}
  </div>
  <div class="group relative">
    <h3 class="text-xl font-semibold text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
      <a href={withBase(`/blog/${post.slug}`)}>
        <span class="absolute inset-0"></span>
        {post.data.title}
      </a>
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-6 text-gray-600 dark:text-gray-400">
      {post.data.description}
    </p>
  </div>
</article>
