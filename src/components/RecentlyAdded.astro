---
import { getRecentItems, labelFor, type RecentItem } from '../lib/recent';

interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;
const items: RecentItem[] = await getRecentItems(limit);

const typeStyle: Record<RecentItem['type'], string> = {
  presentation: 'bg-accent-500/10 text-accent-600 dark:text-accent-400',
  blog: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
  article: 'bg-sky-500/10 text-sky-600 dark:text-sky-400',
  project: 'bg-amber-500/10 text-amber-600 dark:text-amber-400',
};
---
<section class="py-12 border-t border-gray-200 dark:border-gray-800 animate-fade-in-up" style="animation-delay: 200ms;">
  <div class="flex justify-between items-baseline mb-8">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Recently Added</h2>
    <span class="text-xs font-mono text-gray-500 dark:text-gray-400">latest across the site</span>
  </div>

  {items.length === 0 ? (
    <p class="text-sm text-gray-500 dark:text-gray-400">Nothing here yet.</p>
  ) : (
    <ul class="divide-y divide-gray-200 dark:divide-gray-800 border-t border-b border-gray-200 dark:border-gray-800">
      {items.map((item) => {
        const formattedDate = item.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });
        return (
          <li class="group">
            <a
              href={item.href}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 py-4 hover:bg-gray-50 dark:hover:bg-gray-900/40 -mx-4 px-4 rounded-md transition-colors"
            >
              <div class="flex items-center gap-3 sm:w-56 shrink-0">
                <span class={`text-xs font-medium px-2 py-1 rounded-full ${typeStyle[item.type]}`}>
                  {labelFor(item.type)}
                </span>
                <time class="text-xs font-mono text-gray-500 dark:text-gray-400" datetime={item.date.toISOString()}>
                  {formattedDate}
                </time>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                  {item.title}{item.external && <span class="text-gray-400 dark:text-gray-500 ml-1">↗</span>}
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">{item.description}</p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )}
</section>
