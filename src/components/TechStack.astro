---
const categories = [
  { name: 'Data Platforms', items: ['Snowflake', 'Databricks', 'PostgreSQL'] },
  { name: 'Orchestration & Modeling', items: ['dbt', 'Dagster', 'Apache Spark', 'Kafka'] },
  { name: 'Cloud & Infrastructure', items: ['Azure', 'AWS', 'Terraform', 'Docker'] },
  { name: 'Languages & Tools', items: ['Python', 'SQL', 'TypeScript', 'Git'] },
];
---
<section class="py-12 border-t border-gray-200 dark:border-gray-800 animate-fade-in-up" style="animation-delay: 100ms;">
  <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">Technical Arsenal</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {categories.map(category => (
      <div>
        <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-4">{category.name}</h3>
        <div class="flex flex-wrap gap-2">
          {category.items.map(item => (
            <span class="text-sm font-mono bg-gray-100 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-800 text-gray-800 dark:text-gray-200 px-3 py-1.5 rounded-md hover:border-accent-500/30 transition-colors cursor-default">
              {item}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
